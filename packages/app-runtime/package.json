{
  "name": "@voyyaa/app-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Fontanería compartida de las apps móviles de VoyYa: transporte HTTP, sesión, almacenamiento seguro, conectividad y cliente de queries. Sin dominio y sin navegación.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "echo \"(app-runtime) sin tests unitarios propios aún\" && exit 0",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@voyyaa/shared": "workspace:*",
    "@voyyaa/ui-mobile": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0",
    "zod": ">=3.23.0",
    "zustand": ">=4.5.0",
    "@tanstack/react-query": ">=5.51.0",
    "expo-secure-store": ">=13.0.0",
    "expo-location": ">=17.0.0",
    "@react-native-community/netinfo": ">=11.3.0"
  },
  "devDependencies": {
    "@react-native-community/netinfo": "11.3.1",
    "@tanstack/react-query": "^5.51.0",
    "@types/node": "^20.16.10",
    "@types/react": "~18.2.79",
    "expo-secure-store": "~13.0.2",
    "expo-location": "~17.0.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "typescript": "^5.5.4",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  }
}

{
  "name": "frontend-yavoy",
  "version": "0.0.1",
  "private": true,
  "description": "VoyYa — apps móviles (Expo/EAS) del pasajero y del conductor + design system y contratos compartidos. Repo standalone: copiado del monorepo VoyYa (apps/passenger, apps/driver, packages/ui-mobile, packages/shared) para desplegar por EAS de forma independiente.",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,md,yaml,yml}\"",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "@expo/plist>@xmldom/xmldom": "^0.8.15"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-34x7-hfp2-rc4v",
        "GHSA-8qq5-rm4j-mr97",
        "GHSA-83g3-92jg-28cx",
        "GHSA-qffp-2rhf-9h96",
        "GHSA-9ppj-qmqm-q256",
        "GHSA-r6q2-hw4h-h46w",
        "GHSA-23hp-3jrh-7fpw",
        "GHSA-8x88-c5mf-7j5w",
        "GHSA-r292-9mhp-454m",
        "GHSA-rxv8-25v2-qmq8",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}

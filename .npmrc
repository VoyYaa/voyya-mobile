# pnpm: reduce fricción de instalación con Expo/React Native en el workspace.
# node-linker=hoisted: Metro no puede resolver dependencias transitivas con el
# enlazado aislado (ver ADR-008). No añadir aquí ninguna interpolación ${VAR}:
# si la variable no existe, pnpm descarta el archivo completo.
node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false

@voyyaa:registry=https://npm.pkg.github.com

{
  "name": "@voyyaa/passenger",
  "version": "0.0.1",
  "private": true,
  "description": "VoyYa — app del pasajero (Expo/React Native). Flujo solicitud → asignación contra el contrato de @voyyaa/shared.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --test src/lib/consent-phase.spec.ts src/lib/active-trip-route.spec.ts src/lib/format-date.spec.ts src/lib/free-cancellation.spec.ts src/lib/company-selection.spec.ts src/lib/no-driver-decision.spec.ts src/lib/driver-change.spec.ts src/lib/coarse-coordinate.spec.ts src/lib/verified-places.spec.ts",
    "eas-build-post-install": "cd ../.. && pnpm run build",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-community/netinfo": "11.3.1",
    "@rnmapbox/maps": "10.1.36",
    "@tanstack/react-query": "^5.51.0",
    "@voyyaa/app-runtime": "workspace:*",
    "@voyyaa/shared": "workspace:*",
    "@voyyaa/ui-mobile": "workspace:*",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-font": "~12.0.10",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "0.27.7",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.52.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.3.0",
    "react-native-web": "~0.19.10",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^20.16.10",
    "@types/react": "~18.2.79",
    "metro-cache": "0.80.12",
    "typescript": "^5.5.4"
  }
}

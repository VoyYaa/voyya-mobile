{
  "expo": {
    "name": "VoyYa Pasajero",
    "slug": "voyya-passenger",
    "owner": "voyya",
    "scheme": "voyya-passenger",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FBF6ED",
      "image": "./assets/splash-mark.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@rnmapbox/maps/app.plugin.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VoyYa usa tu ubicación aproximada al abrir la app para confirmar que estás en zona de cobertura y ubicarte en el mapa al pedir tu taxi.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "android": {
      "package": "co.voyya.passenger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#2A2018"
      }
    },
    "ios": {
      "bundleIdentifier": "co.voyya.passenger",
      "supportsTablet": false
    },
    "extra": {
      "eas": {
        "projectId": "a16e7c12-bc4e-4eda-8a8f-3892e0887ee8"
      }
    }
  }
}

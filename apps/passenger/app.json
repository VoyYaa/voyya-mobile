{
  "expo": {
    "name": "VoyYa Pasajero",
    "slug": "voyya-passenger",
    "owner": "REEMPLAZAR_CUENTA_O_ORG_EXPO",
    "scheme": "voyya-passenger",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FBF6ED",
      "image": "./assets/splash-mark.png",
      "resizeMode": "contain"
    },
    "plugins": ["expo-router", "expo-secure-store", "@rnmapbox/maps/app.plugin.js"],
    "android": {
      "package": "co.voyya.passenger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#2A2018"
      }
    },
    "ios": {
      "bundleIdentifier": "co.voyya.passenger",
      "supportsTablet": false
    }
  }
}

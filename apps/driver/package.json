{
  "name": "@voyyaa/driver",
  "version": "0.0.1",
  "private": true,
  "description": "VoyYa — app del conductor (Expo/React Native). Solicitud → countdown → aceptación contra el contrato de @voyyaa/shared.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "test": "node --test src/offers/offer-rail.spec.ts src/auth/pin-rules.spec.ts src/auth/pin-errors.spec.ts src/auth/route-gate.spec.ts src/privacy/privacy-status.spec.ts plugins/with-navigation-app-queries.spec.js && node --test --import ../../packages/app-runtime/test-support/resolve-ts-extension.mjs src/trip/directions-url.spec.ts src/trip/route-opener.spec.ts src/trip/start-code-flow.spec.ts src/tracking/sharing-machine.spec.ts",
    "eas-build-post-install": "cd ../.. && pnpm run build",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-community/netinfo": "11.3.1",
    "@tanstack/react-query": "^5.51.0",
    "@voyyaa/app-runtime": "workspace:*",
    "@voyyaa/shared": "workspace:*",
    "@voyyaa/ui-mobile": "workspace:*",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-font": "~12.0.10",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.3.0",
    "react-native-web": "~0.19.10",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^20.16.10",
    "@types/react": "~18.2.79",
    "metro-cache": "0.80.12",
    "typescript": "^5.5.4"
  }
}
